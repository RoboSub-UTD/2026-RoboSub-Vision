# Settings for stream.py (read by run.sh and rov-video.service). Restart after editing:
#   sudo systemctl restart rov-video      (or rerun ./run.sh)
#
# Topside laptop (tether). For Wi-Fi testing, put the laptop's Wi-Fi IP here.
ROV_TOPSIDE_IP=192.168.1.69

# "auto" = the first USB camera -> UDP 5000 (the ROV has one pilot camera).
# To pin a specific camera (e.g. if another USB video device is ever plugged in), run
#   python3 stream.py --list
# and paste its by-path name here as DEVICE:PORT[:WxH@FPS]:
# ROV_CAMERAS="/dev/v4l/by-path/platform-xhci-hcd.0-usb-0:1:1.0-video-index0:5000"
ROV_CAMERAS=auto

# h264  = re-encode on the Pi (CPU heavy: the Pi 5 has no hardware H.264 encoder), ~12 Mbit/s
# mjpeg = forward the camera's JPEG frames as-is (almost no CPU, several times the bandwidth).
#         The topside must run the vision interface with ROV_VIDEO_CODEC=mjpeg as well.
ROV_VIDEO_CODEC=h264
ROV_VIDEO_BITRATE=12000
ROV_VIDEO_SIZE=1920x1080@30
ROV_VIDEO_ENCODER=auto
