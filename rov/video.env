# Settings for stream.py (read by run.sh and rov-video.service). Restart after editing:
#   sudo systemctl restart rov-video      (or rerun ./run.sh)

# Where the video goes: the topside laptop.
#   Wi-Fi testing:     10.6.18.143 (the laptop's Wi-Fi address)
#   Tether (competition): 192.168.1.69
ROV_TOPSIDE_IP=10.6.18.143
# ROV_TOPSIDE_IP=192.168.1.69

# "auto" = the first USB camera -> UDP 5000 (the ROV has one pilot camera).
# To pin a specific camera, run  python3 stream.py --list  and paste its by-path name as DEVICE:PORT:
# ROV_CAMERAS="/dev/v4l/by-path/platform-xhci-hcd.0-usb-0:2:1.0-video-index0:5000"
ROV_CAMERAS=auto

# mjpeg       = send the camera's own JPEG frames (best picture, ~7% CPU, ~45 Mbit/s at 1080p).
#               Tested clean over Wi-Fi once the laptop's background scans were stopped.
# camera-h264 = the camera's own H.264 (~1.4 Mbit/s, softer picture); for a weak link.
# h264        = re-encode on the Pi with x264 (CPU heavy; the Pi 5 has no hardware encoder).
# The topside interface must match: its run.sh defaults to mjpeg.
ROV_VIDEO_CODEC=mjpeg
ROV_VIDEO_SIZE=1920x1080@30

# mjpeg only: 0 = send the camera's frames as-is (recommended).
# 1-100 = re-compress on the Pi. Only worth it at 720p on a struggling link (e.g. 720p + 70 = ~17 Mbit/s);
# at 1080p it barely lowers the bitrate and costs half a CPU core (more heat).
ROV_JPEG_QUALITY=0

# h264 mode only
ROV_VIDEO_BITRATE=12000
ROV_VIDEO_ENCODER=auto

# Camera settings applied every time the camera starts (they reset when it's unplugged or the Pi reboots).
# exposure_dynamic_framerate=0 keeps 30 fps in dim water; power_line_frequency=2 is 60 Hz (US) to avoid flicker.
# Leave empty to not touch the camera. See all controls: v4l2-ctl -d /dev/video0 --list-ctrls
ROV_CAMERA_CONTROLS=exposure_dynamic_framerate=0,power_line_frequency=2
